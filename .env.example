# DAO Governance frontend — environment variables.
# Copy this file to ".env" and fill in values as needed.
# All NEXT_PUBLIC_* values are inlined into the client bundle.

# Arbitrum Sepolia RPC endpoint (optional; falls back to the default public RPC).
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# Governor ProposalCreated scan start block (optional; defaults to the deploy block).
NEXT_PUBLIC_GOVERNOR_DEPLOY_BLOCK=

# Contract address overrides (optional; defaults to the deployed Arbitrum Sepolia instances).
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TIMELOCK_ADDRESS=
NEXT_PUBLIC_GOVERNOR_ADDRESS=
NEXT_PUBLIC_EXECUTION_TARGET_ADDRESS=

# Supabase (optional; only used if a persistence layer is added later).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
