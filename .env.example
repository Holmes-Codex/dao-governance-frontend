# All variables are optional. Copy to .env.local to override.
# Everything prefixed NEXT_PUBLIC_ is shipped to the browser — never put secrets here.

# Public Arbitrum Sepolia RPC endpoint. Defaults to https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# Contract address overrides. Invalid values are ignored and the defaults are used.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TIMELOCK_ADDRESS=
NEXT_PUBLIC_GOVERNOR_ADDRESS=
NEXT_PUBLIC_EXECUTION_TARGET_ADDRESS=
